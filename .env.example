# -----------------------------------------------------------------------
# Tradera Indexer – example environment configuration
# Copy this file to .env and fill in your actual values.
# -----------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Developer credentials (required for publishing via the SOAP API)
# Register at https://developer.tradera.com/ to get these.
# ---------------------------------------------------------------------------
TRADERA_APP_ID=0
TRADERA_APP_KEY=your_app_key_here

# ---------------------------------------------------------------------------
# User/seller credentials (required for publishing listings on behalf of a user)
# Obtain via Tradera's OAuth flow.
# ---------------------------------------------------------------------------
TRADERA_USER_TOKEN=
TRADERA_USER_ID=0

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Path to the local SQLite database (created automatically on first run).
TRADERA_DB_PATH=tradera_index.db

# ---------------------------------------------------------------------------
# Indexer behaviour
# ---------------------------------------------------------------------------
# Maximum number of items to index per category before stopping.
TRADERA_MAX_ITEMS_PER_CATEGORY=1000

# Number of items to request per page from the API.
TRADERA_ITEMS_PER_PAGE=50

# Seconds to wait between API requests (be polite to Tradera's servers).
TRADERA_REQUEST_DELAY=0.5

# ---------------------------------------------------------------------------
# Advanced / environment switching
# ---------------------------------------------------------------------------
# Set to "true" to use the Tradera sandbox instead of production.
TRADERA_SANDBOX=false

# Override the base URL for the Tradera website (rarely needed).
TRADERA_BASE_URL=https://www.tradera.com

# Override the SOAP API URL (rarely needed; ignored when SANDBOX=true).
TRADERA_SOAP_API_URL=https://api.tradera.com/v3
